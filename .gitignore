# --- Dữ liệu tải riêng, không commit -------------------------------------
# reteco_data: 4,5 GB tải từ HuggingFace
#   hf download DataScience-UIBK/RETECO-SemEval2027 --repo-type dataset \
#       --local-dir reteco_data
# RETECO: bộ công cụ chính thức
#   git clone https://github.com/DataScienceUIBK/RETECO.git
reteco_data/
RETECO/

# --- Kết quả suy ra được từ dữ liệu ---------------------------------------
# Bộ nhớ đệm của notebook EDA. Cố tình KHÔNG commit: nếu code quét thay đổi
# mà file đệm cũ vẫn còn, notebook sẽ đọc kết quả cũ và không báo gì cả.
# Xoá thư mục này là notebook tự quét lại.
notebooks/eda_cache/
eda_cache/

# Kết quả chạy hệ thống: tái tạo được, và file TREC rất lớn
runs/**/*.txt
runs/**/*.trec
runs/scratch/
cache/

# Danh sách tài liệu thô của mỗi lần chạy. Rất lớn (diagnostics_runs.json
# nặng 37,7 MB) và tái tạo được: xoá đi là notebook tự chạy lại.
# Phần ĐIỂM SỐ thì vẫn commit -- đó mới là thứ cần đọc lại sau này.
notebooks/results/*_runs.json
results/*_runs.json

# Danh sách toàn bộ term được chọn (mục 8 của 03a). Cỡ hàng chục MB và sinh
# lại được bằng chính ô lệnh đó. Phần THỐNG KÊ (term_stats.json, có sẵn 200
# term đứng đầu) thì vẫn commit -- đó mới là thứ cần đọc lại sau này.
notebooks/results/terms_selected.txt
results/terms_selected.txt

# Bảng nhóm bản sao (mục 1 của 07a). 49 MB, suy ra được bằng một lượt quét
# kho khoảng 8 phút: P.build_dup_groups(). Phần KẾT LUẬN rút ra từ nó
# (dedup_summary.json) thì vẫn commit.
notebooks/results/dup_groups/
results/dup_groups/

# Điểm do máy GPU trả về, và gói việc gửi đi. Tái tạo được từ cấu hình hệ
# thống cộng với mô hình đã ghi trong job.json.
notebooks/results/gpu/
results/gpu/
gpu_jobs/

# Đầu ra của khung ở notebook 06b.
#   runs/   danh sách tài liệu, rất lớn, tái tạo được từ cấu hình
#   scores/ và index.json thì VẪN COMMIT: đó là thứ hai người ghép với nhau
notebooks/results/runs/
results/runs/

# File nộp: sinh lại được, và không nên lẫn vào lịch sử
submissions/

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/

# --- Hệ điều hành và trình soạn thảo ---------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Bí mật, tuyệt đối không commit ----------------------------------------
.env
*.token
kaggle.json
