#   hf download DataScience-UIBK/RETECO-SemEval2027 --repo-type dataset \
#       --local-dir reteco_data
# RETECO: bộ công cụ chính thức
#   git clone https://github.com/DataScienceUIBK/RETECO.git
reteco_data/
RETECO/

# --- Kết quả suy ra được từ dữ liệu ---------------------------------------
# Bộ nhớ đệm của notebook EDA. Cố tình KHÔNG commit: nếu code quét thay đổi
# mà file đệm cũ vẫn còn, notebook sẽ đọc kết quả cũ và không báo gì cả.
# Xoá thư mục này là notebook tự quét lại.
notebooks/eda_cache/
eda_cache/

# Kết quả chạy hệ thống: tái tạo được, và file TREC rất lớn
runs/**/*.txt
runs/**/*.trec
runs/scratch/
cache/

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/

